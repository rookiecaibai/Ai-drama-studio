# 复制为 .env 后按需修改：cp .env.example .env
# .env 不要提交到 Git（里面会有密钥），.env.example 要提交（告诉同事需要哪些变量）

APP_NAME=AI Drama Studio
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# 本地开发：SQLite 零配置，删库就是删文件
DATABASE_URL=sqlite+pysqlite:///./ai_drama.db
# 生产环境示例（注意 charset=utf8mb4，否则中文和 emoji 会存成问号）：
# DATABASE_URL=mysql+pymysql://drama:密码@db:3306/ai_drama?charset=utf8mb4

# 生产环境请改成 false，表结构交给 Alembic 迁移管理
AUTO_CREATE_TABLES=true

# ---------- 安全 / 鉴权 ----------
# 生产环境必须换成随机长字符串：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- 配额 / 限流 ----------
# 每用户每天最多生成次数（AI 调用是钱，必须设上限；0 表示不限制）
DAILY_GENERATION_LIMIT=20
# 登录失败限流：窗口期内最多失败次数
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SEC=600

# ---------- 大模型 ----------
# mock：本地假数据，不需要 Key 就能跑通全流程
# openai_compat：任何 OpenAI 兼容接口（DeepSeek / 通义 / Kimi / 智谱 / OpenAI / 本地 Ollama）
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SEC=60

# ---------- 图片生成（文生图） ----------
# mock：本地生成占位图（把英文提示词画在画面上），不联网、不花钱，用来调通整条链路
# openai_compat：任何兼容 OpenAI 图片接口的服务，推荐两个：
#   智谱 CogView-3-Flash（免费）：IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   硅基流动（便宜、模型多）：    IMAGE_BASE_URL=https://api.siliconflow.cn/v1
#                                同时把 IMAGE_SIZE_PARAM 改成 image_size
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
IMAGE_MODEL=cogview-3-flash
# 尺寸要和成片方向一致：成片是 720x1280 竖屏，所以图片也该是竖的。
# 智谱支持的枚举：1024x1024 / 768x1344 / 864x1152 / 1344x768 / 1152x864 / 1440x720 / 720x1440
# 竖屏短剧推荐 768x1344（最接近 9:16，合成时几乎铺满画面、不留黑边）
IMAGE_SIZE=768x1344
# 不同厂商对"尺寸"参数叫法不同：OpenAI / 智谱用 size，硅基流动用 image_size
IMAGE_SIZE_PARAM=size
IMAGE_TIMEOUT_SEC=120

# 生成的图片存哪里（相对 backend 目录）。生产环境可换成对象存储
MEDIA_ROOT=./media

# ---------- 厂商私有参数透传（JSON）----------
# 各家有各家的私有参数，做成配置就不必为每家改代码。
# 注意：model / prompt / size / voice 这些必需字段优先级更高，这里覆盖不了它们。
#
# 智谱去水印（图片和音频都支持）：
#   1) 先在控制台打开开关：个人中心 → 安全管理 → 去水印管理
#   2) 再填下面两行；官方文档原话："false: 关闭所有水印，仅对已完成去水印动作的用户生效"
IMAGE_EXTRA_PARAMS={"watermark_enabled": false}
TTS_EXTRA_PARAMS={"watermark_enabled": false}

# 每用户每天最多生成多少张图（图片比文本贵得多，和文本配额分开算）
DAILY_IMAGE_LIMIT=30

# ---------- 配音（TTS） ----------
# mock：本地合成一段可播放的提示音，不联网、不花钱
# openai_compat：兼容 OpenAI /audio/speech 的服务，推荐：
#   智谱 GLM-TTS（同一个智谱 Key 就能用，支持语速/音量，情感表达强）：
#       TTS_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#       TTS_MODEL=glm-tts   TTS_VOICE=tongtong
#       可用音色（实测基频，供选角参考）：
#         xiaochen 134Hz 男声 | tongtong 183Hz 女声(偏低) | kazi 183Hz 女声(偏低)
#         jam 238Hz 女声 | chuichui 245Hz 女声 | luodo 247Hz 女声 | douji 316Hz 童声
#   硅基流动 CosyVoice：TTS_BASE_URL=https://api.siliconflow.cn/v1
#                       TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B   TTS_VOICE=claire
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_BASE_URL=https://open.bigmodel.cn/api/paas/v4
TTS_MODEL=glm-tts
TTS_VOICE=tongtong
TTS_RESPONSE_FORMAT=wav
# 只有支持 instructions 之类"语气"参数的厂商才填；留空 = 不发送
# （镜头的 audio_prompt 会作为这个参数的值传进去）
TTS_INSTRUCTIONS_PARAM=
TTS_TIMEOUT_SEC=120

# 每用户每天最多生成多少段配音
DAILY_AUDIO_LIMIT=60

# ---------- 视频合成 ----------
# 留空 = 自动查找：系统 PATH -> imageio-ffmpeg 自带的内置二进制
# （所以开发机不用手工装 ffmpeg；生产 Docker 里 apt 装一个并在这里指定即可）
FFMPEG_PATH=
# 成片尺寸：默认竖屏 9:16，短剧就该是竖着的
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=25
# CRF 越小越清晰、文件越大（26 对草稿预览够用，正式发布可用 20）
VIDEO_CRF=26
VIDEO_PRESET=veryfast

# 每用户每天最多合成多少次视频（限的是服务器 CPU，不是钱）
DAILY_VIDEO_LIMIT=10

# 每用户每天最多生成多少张角色三视图。
# 单独设限的理由：三视图是一张图一次调用，用户会反复调角色卡重生成（不满意就重画），
# 和"整集批量出图"是两种使用节奏，混在一个额度里会互相挤占。
DAILY_TURNAROUND_LIMIT=20

# ---------- 用户自带 API Key（BYOK）----------
# 每个短剧可以在「短剧设置」里填自己的模型与 Key（加密落库、接口永不回显）。
# 下面这个开关决定"用户没填 Key 时怎么办"：
#   true （默认）：回退到上面这些服务端配置 —— 方便试玩，但**花的是你的钱**
#   false        ：严格 BYOK —— 每个短剧必须填自己的 Key 才能生成
# ⚠️ 部署到公网时建议设为 false，否则陌生人能刷爆你的账户。
ALLOW_SERVER_KEY_FALLBACK=true

# ---------- 图生视频（让画面真的动起来） ----------
# 不做这一步，成片就是"每张图定格 + 配音"的幻灯片 —— 画面完全静止，只有声音在动。
#   none:          不生成动态片段（成片仍用静态图，即最初的行为）
#   mock:          本地 ffmpeg 做运镜（推近/拉远/左右平移）—— 免费、不联网，
#                  画面**确实会动**（是运镜不是真动作），用来跑通链路和演示
#   openai_compat: 真调图生视频模型（异步提交 + 轮询取结果）
VIDEO_CLIP_PROVIDER=mock

# 留空则复用 IMAGE_API_KEY —— 智谱的文生图和图生视频是同一个 Key
VIDEO_API_KEY=
VIDEO_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- 模型选择（官方定价，2026-10 核对）----
#   cogvideox-flash  免费      —— 但会排队限流（实测 5 次全是 429），且不支持 duration
#   cogvideox-2      0.5 元/次 —— 性价比最高；竖屏要用 1080x1920；不支持 duration
#   cogvideox-3      1 元/次   —— 最新最好；竖屏用 720x1280；支持 duration
#   vidu2-image      1.25 元/次（720p） / viduq1-image 2.5 元/次（1080p）
VIDEO_MODEL=cogvideox-3
# 尺寸要挑"竖屏且比例接近 9:16"的，否则合成时会补黑边：
#   cogvideox-3  -> 720x1280  （比例 0.5625，和成片完全一致）
#   cogvideox-2  -> 1080x1920 （比例 0.5625，也是 9:16；它的 960x1280 是 3:4，会补黑边）
VIDEO_SIZE=720x1280
# duration 只有 cogvideox-3 支持；用 cogvideox-2 / cogvideox-flash 时改成 false
VIDEO_SEND_DURATION=true
VIDEO_QUALITY=speed
VIDEO_CLIP_SECONDS=5
# 视频生成很慢，所以超时给得宽；但**也不要给太长**：
# 一个 5 秒的片段等超过 6 分钟基本就是出问题了，早失败早重试更好
VIDEO_TIMEOUT_SEC=60
VIDEO_POLL_INTERVAL_SEC=6
VIDEO_POLL_TIMEOUT_SEC=360
# 视频厂商私有参数（和 IMAGE_EXTRA_PARAMS 同样格式）
VIDEO_EXTRA_PARAMS={"watermark_enabled": false}

# 每用户每天最多生成多少个动态镜头（视频比图片贵得多，单独设限）
DAILY_CLIP_LIMIT=30

# 复制为 .env 后按需修改：cp .env.example .env
# .env 不要提交到 Git（里面会有密钥），.env.example 要提交（告诉同事需要哪些变量）

APP_NAME=AI Drama Studio
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# 本地开发：SQLite 零配置，删库就是删文件
DATABASE_URL=sqlite+pysqlite:///./ai_drama.db
# 生产环境示例（注意 charset=utf8mb4，否则中文和 emoji 会存成问号）：
# DATABASE_URL=mysql+pymysql://drama:密码@db:3306/ai_drama?charset=utf8mb4

# 生产环境请改成 false，表结构交给 Alembic 迁移管理
AUTO_CREATE_TABLES=true

# ---------- 安全 / 鉴权 ----------
# 生产环境必须换成随机长字符串：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- 配额 / 限流 ----------
# 每用户每天最多生成次数（AI 调用是钱，必须设上限；0 表示不限制）
DAILY_GENERATION_LIMIT=20
# 登录失败限流：窗口期内最多失败次数
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SEC=600

# ---------- 大模型 ----------
# mock：本地假数据，不需要 Key 就能跑通全流程
# openai_compat：任何 OpenAI 兼容接口（DeepSeek / 通义 / Kimi / 智谱 / OpenAI / 本地 Ollama）
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SEC=60

# 复制为 .env 后按需修改：cp .env.example .env
# .env 不要提交到 Git（里面会有密钥），.env.example 要提交（告诉同事需要哪些变量）

APP_NAME=AI Drama Studio
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# 本地开发：SQLite 零配置，删库就是删文件
DATABASE_URL=sqlite+pysqlite:///./ai_drama.db
# 生产环境示例（注意 charset=utf8mb4，否则中文和 emoji 会存成问号）：
# DATABASE_URL=mysql+pymysql://drama:密码@db:3306/ai_drama?charset=utf8mb4

# 生产环境请改成 false，表结构交给 Alembic 迁移管理
AUTO_CREATE_TABLES=true

# ---------- 安全 / 鉴权 ----------
# 生产环境必须换成随机长字符串：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- 配额 / 限流 ----------
# 每用户每天最多生成次数（AI 调用是钱，必须设上限；0 表示不限制）
DAILY_GENERATION_LIMIT=20
# 登录失败限流：窗口期内最多失败次数
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SEC=600

# ---------- 大模型 ----------
# mock：本地假数据，不需要 Key 就能跑通全流程
# openai_compat：任何 OpenAI 兼容接口（DeepSeek / 通义 / Kimi / 智谱 / OpenAI / 本地 Ollama）
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SEC=60

# ---------- 图片生成（文生图） ----------
# mock：本地生成占位图（把英文提示词画在画面上），不联网、不花钱，用来调通整条链路
# openai_compat：任何兼容 OpenAI 图片接口的服务，推荐两个：
#   智谱 CogView-3-Flash（免费）：IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   硅基流动（便宜、模型多）：    IMAGE_BASE_URL=https://api.siliconflow.cn/v1
#                                同时把 IMAGE_SIZE_PARAM 改成 image_size
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
IMAGE_MODEL=cogview-3-flash
IMAGE_SIZE=1024x1024
# 不同厂商对"尺寸"参数叫法不同：OpenAI / 智谱用 size，硅基流动用 image_size
IMAGE_SIZE_PARAM=size
IMAGE_TIMEOUT_SEC=120

# 生成的图片存哪里（相对 backend 目录）。生产环境可换成对象存储
MEDIA_ROOT=./media

# 每用户每天最多生成多少张图（图片比文本贵得多，和文本配额分开算）
DAILY_IMAGE_LIMIT=30

# ---------- 配音（TTS） ----------
# mock：本地合成一段可播放的提示音，不联网、不花钱
# openai_compat：兼容 OpenAI /audio/speech 的服务，推荐：
#   硅基流动 CosyVoice：TTS_BASE_URL=https://api.siliconflow.cn/v1
#                       TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B   TTS_VOICE=claire
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_BASE_URL=https://api.siliconflow.cn/v1
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=claire
TTS_RESPONSE_FORMAT=mp3
# 只有支持 instructions 之类"语气"参数的厂商才填；留空 = 不发送
# （镜头的 audio_prompt 会作为这个参数的值传进去）
TTS_INSTRUCTIONS_PARAM=
TTS_TIMEOUT_SEC=120

# 每用户每天最多生成多少段配音
DAILY_AUDIO_LIMIT=60

# ---------- 视频合成 ----------
# 留空 = 自动查找：系统 PATH -> imageio-ffmpeg 自带的内置二进制
# （所以开发机不用手工装 ffmpeg；生产 Docker 里 apt 装一个并在这里指定即可）
FFMPEG_PATH=
# 成片尺寸：默认竖屏 9:16，短剧就该是竖着的
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=25
# CRF 越小越清晰、文件越大（26 对草稿预览够用，正式发布可用 20）
VIDEO_CRF=26
VIDEO_PRESET=veryfast

# 每用户每天最多合成多少次视频（限的是服务器 CPU，不是钱）
DAILY_VIDEO_LIMIT=10
